classDiagram
    class Priority {
        <<enumeration>>
        LOW
        MEDIUM
        HIGH
    }

    class Task {
        +str title
        +int duration_minutes
        +Priority priority
        +str category
        +str preferred_time
        +bool completed
        +mark_complete() None
        +priority_value() int
        +__str__() str
    }

    class Pet {
        +str name
        +str species
        +int age
        +str special_needs
        +list~Task~ tasks
        +add_task(task) None
        +edit_task(title, changes) None
        +remove_task(title) None
        +get_tasks() list~Task~
    }

    class Owner {
        +str name
        +int available_minutes
        +dict preferences
        +list~Pet~ pets
        +add_pet(pet) None
        +remove_pet(name) None
        +get_all_tasks() list~Pet_Task_pair~
    }

    class ScheduledItem {
        +Task task
        +Pet pet
        +time start
        +time end
        +str reason
    }

    class DailyPlan {
        +date date
        +list~ScheduledItem~ entries
        +list~SkippedTask~ skipped
        +int total_minutes
        +add_entry(item) None
        +add_skipped(task, reason) None
        +summary() str
        +explain() str
    }

    class Scheduler {
        +Owner owner
        +time start_time
        +generate_plan() DailyPlan
        -_sort_tasks(tasks) list
        -_fit_to_time(tasks) list
        -_assign_times(tasks) list~ScheduledItem~
        -_explain(task, reason) str
    }

    Task --> Priority : uses
    Owner "1" *-- "many" Pet : has
    Pet "1" *-- "many" Task : has
    Scheduler --> Owner : reads
    Scheduler ..> DailyPlan : creates
    DailyPlan "1" *-- "many" ScheduledItem : contains
    ScheduledItem --> Task : schedules
    ScheduledItem --> Pet : for
